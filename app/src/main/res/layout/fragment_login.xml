<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="260dp"
            android:layout_height="100dp"
            android:contentDescription="MAXI tv"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Adresse du serveur (http://...)"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:maxLength="300"
                android:nextFocusDown="@+id/user"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textColorHint="@color/muted" />

            <EditText
                android:id="@+id/user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Identifiant"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions"
                android:maxLength="100"
                android:nextFocusDown="@+id/pass"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textColorHint="@color/muted" />

            <EditText
                android:id="@+id/pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mot de passe"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLength="100"
                android:nextFocusDown="@+id/connect"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textColorHint="@color/muted" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="24dp"
                android:textColor="@color/muted" />

            <Button
                android:id="@+id/connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nextFocusDown="@+id/cancel"
                android:text="Se connecter" />

            <Button
                android:id="@+id/cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Annuler"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
